# Public app URL (production)
NEXTAUTH_URL=https://pagosenlinea.sshlc.org
NEXT_PUBLIC_APP_URL=https://pagosenlinea.sshlc.org

# Required for NextAuth sessions (generate locally, e.g. `openssl rand -base64 32`)
# Put the real value only on the app host (.43) — never commit it.
NEXTAUTH_SECRET=

# Google OAuth (required for real Google account picker)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Authorized redirect URI to register in Google Cloud Console:
#   https://pagosenlinea.sshlc.org/api/auth/callback/google
# Optional LAN/dev redirect (only if you also test OAuth on LAN):
#   http://192.168.1.43:8421/api/auth/callback/google
#   http://localhost:8421/api/auth/callback/google

# Microsoft / Azure AD (optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Authorized redirect URI in Azure app registration:
#   https://pagosenlinea.sshlc.org/api/auth/callback/azure-ad

# SIMA read-only DB for folio de cuenta/venta verification (dev .64; never write)
# Used by POST /api/pago-rapido/buscar — set only on the app host (.43)
SIMA_DB_HOST=192.168.1.64
SIMA_DB_PORT=3306
SIMA_DB_USER=
SIMA_DB_PASSWORD=

# Demo tarjeta / fake 3DS (LAN). Production leap: set false + wire real processor.
NEXT_PUBLIC_DEMO_PAYMENTS=true

# SMTP for real receipt email (developer). Never commit real passwords.
# Values come from db1.properties pagosenlinea.user / pagosenlinea.password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# If SMTP_USER has no @, append this domain for Gmail login/from
SMTP_FROM_DOMAIN=lacarlota.um.edu.mx
# Optional override: Pagos en línea <user@domain>
SMTP_FROM=

# Mercado Pago SPEI/OXXO — stashed off by default. Set true + tokens to re-enable.
PAYMENTS_LAN_ONLY=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Optional webhook secret from Mercado Pago → Your integrations → Webhooks
MERCADOPAGO_WEBHOOK_SECRET=

# Portal payments DB (dev schema on .64 — not mysqlmain .11)
PAGOS_DB_HOST=192.168.1.64
PAGOS_DB_PORT=3306
PAGOS_DB_NAME=pagos
PAGOS_DB_USER=
PAGOS_DB_PASSWORD=

# Webhook URL to register in Mercado Pago (topic: Payments):
#   https://pagosenlinea.sshlc.org/api/webhooks/mercadopago

